# Copy to .env and fill in. .env is git-ignored — never commit real keys.
#
# Safe to ship in the app bundle: the publishable key only grants what
# Row Level Security allows.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service role key here or anywhere in the app.
# It lives only in Supabase Edge Function secrets and GitHub Actions secrets.
